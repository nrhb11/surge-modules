#!name = YouTube Premium-like Universal + DualSubs 双语增强
#!desc = YouTube + YouTube Music 全功能超级套件：覆盖 Mac 网页与 iPhone/iPad 官方 App。集成广告拦截（贴片/暂停/信息流）、后台播放、画中画，以及 DualSubs 实时中外双语字幕（视频）与双语歌词（YT Music）翻译。所有脚本均自托管在本仓库。
#!author = nrhb11 & VirgilClyne & Maasea
#!category = Streaming
#!version = 2.0.0
#!date = 2026-08-24 21:50:00
#!arguments = hideShorts:false,captionLang:"zh-Hans",dualSubsAutoCC:true,dualSubsPosition:"Forward",dualSubsVendor:"Google",dualSubsType:"Official",dualSubsTypes:"Translate",dualSubsShowOnly:false,debug:false
#!arguments-desc = hideShorts: 是否隐藏 Shorts 视频栏目\ncaptionLang: App端字幕语言代码(默认 zh-Hans，关闭填 off)\ndualSubsAutoCC: 网页端是否自动开启字幕\ndualSubsPosition: 字幕主语言位置(Forward:上方, Reverse:下方)\ndualSubsVendor: 翻译服务商(Google/DeepL/Microsoft)\ndualSubsType: 字幕启用类型(Official:官方合成, Translate:机器翻译)\ndualSubsTypes: 歌词启用类型(Translate:翻译歌词)\ndualSubsShowOnly: 是否仅显示翻译字幕\ndebug: 是否输出调试日志

[Rule]
DOMAIN-SUFFIX,doubleclick.net,REJECT-TINYGIF,pre-matching,extended-matching
DOMAIN-SUFFIX,googlesyndication.com,REJECT-TINYGIF,pre-matching,extended-matching
DOMAIN-SUFFIX,googleadservices.com,REJECT-TINYGIF,pre-matching,extended-matching
DOMAIN-SUFFIX,2mdn.net,REJECT-TINYGIF,pre-matching,extended-matching
DOMAIN-SUFFIX,googletagservices.com,REJECT-TINYGIF,pre-matching,extended-matching
DOMAIN,youtube-ads.l.google.com,REJECT-TINYGIF,pre-matching,extended-matching
URL-REGEX,^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*oad=.+)$,REJECT-TINYGIF

[URL Rewrite]
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302
^https?:\/\/(www\.|m\.)?youtube\.com\/youtubei\/v1\/player\/ad_break _ reject
^https?:\/\/(www\.|m\.)?youtube\.com\/pcs\/activeview _ reject
^https?:\/\/(www\.|m\.)?youtube\.com\/pagead\/ _ reject
^https?:\/\/(www\.|m\.)?youtube\.com\/get_midroll_ _ reject

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback(?:\?|\/))).+&oad data-type=text data=" " status-code=200

[Script]
# --- Web 网页端去广告与体验优化 ---
youtube.web.compat = type=http-request, pattern=^https:\/\/(www\.|m\.)?youtube\.com\/youtubei\/v1\/.*, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/youtube/scripts/youtube-web-request.js?v=20260824.2, script-update-interval=3600
youtube.web.home-data = type=http-response, pattern=^https:\/\/(www\.)?youtube\.com\/(\?.*)?$, requires-body=1, max-size=-1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/youtube/scripts/youtube-home-response.js?v=20260824.2, argument="{\"hideShorts\":{{{hideShorts}}},\"debug\":{{{debug}}}}", script-update-interval=3600
youtube.web.api = type=http-response, pattern=^https:\/\/(www\.|m\.)?youtube\.com\/youtubei\/v1\/(browse|next|search|player|get_watch)(\?.*)?$, requires-body=1, max-size=-1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/youtube/scripts/youtube-premium-like.js?v=20260824.2, argument="{\"hideShorts\":{{{hideShorts}}},\"debug\":{{{debug}}}}", script-update-interval=3600
youtube.music.api = type=http-response, pattern=^https:\/\/music\.youtube\.com\/youtubei\/v1\/(browse|next|search|player|queue|get_watch)(\?.*)?$, requires-body=1, max-size=-1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/youtube/scripts/youtube-premium-like.js?v=20260824.2, argument="{\"hideShorts\":{{{hideShorts}}},\"debug\":{{{debug}}}}", script-update-interval=3600

# --- App 移动端去广告、后台播放与字幕增强 ---
youtube.mobile.response = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|config|log_event)(\?.*)?$, requires-body=1, max-size=-1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/youtube/vendor/youtube-mobile-response.js?v=20260824.2, argument="{\"captionLang\":\"{{{captionLang}}}\",\"blockUpload\":false,\"blockImmersive\":false,\"blockShorts\":{{{hideShorts}}},\"debug\":{{{debug}}}}", script-update-interval=3600

# --- DualSubs Web 端实时双语字幕 ---
🍿️ DualSubs.YouTube.TimedText.request = type=http-request, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext(\?.+)?$, engine=webview, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/youtube/scripts/dualsubs/DualSubs.YouTube.request.js?v=20260824.2, argument=Type="{{{dualSubsType}}}"&Types="{{{dualSubsTypes}}}"&AutoCC="{{{dualSubsAutoCC}}}"&Position="{{{dualSubsPosition}}}"&Vendor="{{{dualSubsVendor}}}"&ShowOnly="{{{dualSubsShowOnly}}}"&LogLevel="{{{debug}}}"
🍿️ DualSubs.YouTube.Composite.TimedText.response = type=http-response, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=(Official|External), requires-body=1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/youtube/scripts/dualsubs/DualSubs.Composite.js?v=20260824.2, argument=Type="{{{dualSubsType}}}"&Types="{{{dualSubsTypes}}}"&AutoCC="{{{dualSubsAutoCC}}}"&Position="{{{dualSubsPosition}}}"&Vendor="{{{dualSubsVendor}}}"&ShowOnly="{{{dualSubsShowOnly}}}"&LogLevel="{{{debug}}}"
🍿️ DualSubs.YouTube.Translate.TimedText.response = type=http-response, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=Translate, requires-body=1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/youtube/scripts/dualsubs/DualSubs.Translate.js?v=20260824.2, argument=Type="{{{dualSubsType}}}"&Types="{{{dualSubsTypes}}}"&AutoCC="{{{dualSubsAutoCC}}}"&Position="{{{dualSubsPosition}}}"&Vendor="{{{dualSubsVendor}}}"&ShowOnly="{{{dualSubsShowOnly}}}"&LogLevel="{{{debug}}}"

# --- DualSubs YouTube Music 双语歌词翻译 ---
🍿️ DualSubs.YouTubeMusic.Translate.Lyrics.response.json = type=http-response, pattern=^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse\?(.*)subtype=Translate, requires-body=1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/youtube/scripts/dualsubs/DualSubs.Translate.js?v=20260824.2, argument=Type="{{{dualSubsType}}}"&Types="{{{dualSubsTypes}}}"&AutoCC="{{{dualSubsAutoCC}}}"&Position="{{{dualSubsPosition}}}"&Vendor="{{{dualSubsVendor}}}"&ShowOnly="{{{dualSubsShowOnly}}}"&LogLevel="{{{debug}}}"

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, www.youtube.com, youtube.com, m.youtube.com, tv.youtube.com, music.youtube.com, s.youtube.com, youtubei.googleapis.com

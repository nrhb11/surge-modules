#!name = TV + DualSubs 增强与双语字幕二合一
#!desc = TV / Apple TV+ 完整增强套件：集成 iRingo 证书固定绕过 + DualSubs 实时双语字幕注入 + Mac/tvOS/iOS 全平台兼容 + 零缓存穿透优化。支持院线电影、自制剧集及带 [CC] 隐藏式字幕影片。所有脚本均自托管在本仓库。
#!author = NSRingo & DualSubs & nrhb11
#!category = Streaming
#!version = 1.0.1
#!date = 2026-08-24 21:33:00
#!arguments = Types:"Official,Translate",Languages[0]:"AUTO",Languages[1]:"ZH",Position:"Reverse",Vendor:"Google",ShowOnly:false,LogLevel:"WARN",ThirdParty:false,isWorkaroundSSLPinning:true
#!arguments-desc = Types: 启用的字幕类型(Official:官方字幕, Translate:翻译字幕)\nLanguages[0]: 主语言(默认 AUTO)\nLanguages[1]: 副语言(默认 ZH)\nPosition: 翻译字幕位置(Forward:上方, Reverse:下方)\nVendor: 翻译引擎供应商(Google/DeepL/Microsoft)\nShowOnly: 是否仅显示副语言字幕\nThirdParty: 启用第三方 App 与 TV app 关联功能\nisWorkaroundSSLPinning: 启用绕过 SSL 证书固定校验\nLogLevel: 调试日志等级(OFF/ERROR/WARN/INFO/DEBUG/ALL)

[Rule]
DOMAIN,known-issues.apple.com,REJECT-DROP

[URL Rewrite]
^https?:\/\/play-cdn\.itunes\.apple\.com https://play.itunes.apple.com header
^https?:\/\/play-edge-cdn\.itunes\.apple\.com https://play-edge.itunes.apple.com header

[Header Rewrite]
^https?:\/\/uts-api\.itunes\.apple\.com\/uts\/(v1|v2|v3)\/ response-header-replace Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
^https?:\/\/uts-api\.itunes\.apple\.com\/uts\/(v1|v2|v3)\/ response-header-del ETag
^https?:\/\/uts-api\.itunes\.apple\.com\/uts\/(v1|v2|v3)\/ response-header-del Last-Modified

[Script]
# --- iRingo 核心重写 ---
📺 TV.uts.request = type=http-request, pattern=^https?:\/\/uts-api\.itunes\.apple\.com\/uts\/(v1|v2|v3)\/, requires-body=1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/appletv/scripts/iRingo.request.bundle.js, argument=ThirdParty="{{{ThirdParty}}}"&isWorkaroundSSLPinning="{{{isWorkaroundSSLPinning}}}"&LogLevel="{{{LogLevel}}}"
📺 TV.uts.response = type=http-response, pattern=^https?:\/\/uts-api\.itunes\.apple\.com\/uts\/(v1|v2|v3)\/, requires-body=1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/appletv/scripts/iRingo.response.bundle.js, argument=ThirdParty="{{{ThirdParty}}}"&isWorkaroundSSLPinning="{{{isWorkaroundSSLPinning}}}"&LogLevel="{{{LogLevel}}}"
📺 TV.umc.request = type=http-request, pattern=^https?:\/\/umc-tempo-api\.apple\.com\/(v1|v2|v3)\/, requires-body=1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/appletv/scripts/iRingo.request.bundle.js, argument=

# --- DualSubs 电影与商店资源 (MZPlay) ---
🍿️ DualSubs.TV.M3U8.Master.response = type=http-response, pattern=^https?:\/\/(play|play-edge|play-cdn|play-edge-cdn|hls)\.itunes\.apple\.com\/WebObjects\/(MZPlay|MZPlayLocal)\.woa\/hls\/playlist\.m3u8, requires-body=1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/appletv/scripts/DualSubs.Manifest.js, argument=Types="{{{Types}}}"&Languages[0]="{{{Languages[0]}}}"&Languages[1]="{{{Languages[1]}}}"&Position="{{{Position}}}"&Vendor="{{{Vendor}}}"&ShowOnly="{{{ShowOnly}}}"&LogLevel="{{{LogLevel}}}"
🍿️ DualSubs.TV.M3U8.Subtitles.response = type=http-response, pattern=^https?:\/\/vod-(.+)-amt\.tv\.apple\.com\/itunes-assets\/(.+)\/([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12})\/(.+)_subtitles(_V\d)?\.m3u8\?(.*)subtype=, requires-body=1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/appletv/scripts/DualSubs.Manifest.js, argument=Types="{{{Types}}}"&Languages[0]="{{{Languages[0]}}}"&Languages[1]="{{{Languages[1]}}}"&Position="{{{Position}}}"&Vendor="{{{Vendor}}}"&ShowOnly="{{{ShowOnly}}}"&LogLevel="{{{LogLevel}}}"
🍿️ DualSubs.TV.Composite.Subtitles.response = type=http-response, pattern=^https?:\/\/vod-(.+)-amt\.tv\.apple\.com\/itunes-assets\/(.+)\/([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12})\/(.+)\.webvtt\?(.*)subtype=(Official|External), requires-body=1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/appletv/scripts/DualSubs.Composite.js, argument=Types="{{{Types}}}"&Languages[0]="{{{Languages[0]}}}"&Languages[1]="{{{Languages[1]}}}"&Position="{{{Position}}}"&Vendor="{{{Vendor}}}"&ShowOnly="{{{ShowOnly}}}"&LogLevel="{{{LogLevel}}}"
🍿️ DualSubs.TV.Translate.Subtitles.response = type=http-response, pattern=^https?:\/\/vod-(.+)-amt\.tv\.apple\.com\/itunes-assets\/(.+)\/([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12})\/(.+)\.webvtt\?(.*)subtype=Translate, requires-body=1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/appletv/scripts/DualSubs.Translate.js, argument=Types="{{{Types}}}"&Languages[0]="{{{Languages[0]}}}"&Languages[1]="{{{Languages[1]}}}"&Position="{{{Position}}}"&Vendor="{{{Vendor}}}"&ShowOnly="{{{ShowOnly}}}"&LogLevel="{{{LogLevel}}}"

# --- DualSubs 订阅自制剧与流媒体资源 (Apple TV+) ---
🍿️ DualSubs.TV+.M3U8.Master.response = type=http-response, pattern=^https?:\/\/(play|play-edge|play-cdn|play-edge-cdn|hls)\.itunes\.apple\.com\/WebObjects\/(MZPlay|MZPlayLocal)\.woa\/hls\/subscription\/playlist\.m3u8, requires-body=1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/appletv/scripts/DualSubs.Manifest.js, argument=Types="{{{Types}}}"&Languages[0]="{{{Languages[0]}}}"&Languages[1]="{{{Languages[1]}}}"&Position="{{{Position}}}"&Vendor="{{{Vendor}}}"&ShowOnly="{{{ShowOnly}}}"&LogLevel="{{{LogLevel}}}"
🍿️ DualSubs.TV+.M3U8.Subtitles.response = type=http-response, pattern=^https?:\/\/(play|play-edge|play-cdn|play-edge-cdn|hls)\.itunes\.apple\.com\/WebObjects\/(MZPlay|MZPlayLocal)\.woa\/hls\/subscription\/stream\/playlist\.m3u8\?(.*)subtype=, requires-body=1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/appletv/scripts/DualSubs.Manifest.js, argument=Types="{{{Types}}}"&Languages[0]="{{{Languages[0]}}}"&Languages[1]="{{{Languages[1]}}}"&Position="{{{Position}}}"&Vendor="{{{Vendor}}}"&ShowOnly="{{{ShowOnly}}}"&LogLevel="{{{LogLevel}}}"
🍿️ DualSubs.TV+.M3U8.Subtitles.response = type=http-response, pattern=^https?:\/\/vod-(.+)-(aoc|svod)\.tv\.apple\.com\/itunes-assets\/(.+)\/([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12})\/(.+)_subtitles_V\d\.m3u8\?(.*)subtype=, requires-body=1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/appletv/scripts/DualSubs.Manifest.js, argument=Types="{{{Types}}}"&Languages[0]="{{{Languages[0]}}}"&Languages[1]="{{{Languages[1]}}}"&Position="{{{Position}}}"&Vendor="{{{Vendor}}}"&ShowOnly="{{{ShowOnly}}}"&LogLevel="{{{LogLevel}}}"
🍿️ DualSubs.TV+.Composite.Subtitles.response = type=http-response, pattern=^https?:\/\/vod-(.+)-(aoc|svod)\.tv\.apple\.com\/itunes-assets\/(.+)\/([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12})\/(.+)\.webvtt\?(.*)subtype=(Official|External), requires-body=1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/appletv/scripts/DualSubs.Composite.js, argument=Types="{{{Types}}}"&Languages[0]="{{{Languages[0]}}}"&Languages[1]="{{{Languages[1]}}}"&Position="{{{Position}}}"&Vendor="{{{Vendor}}}"&ShowOnly="{{{ShowOnly}}}"&LogLevel="{{{LogLevel}}}"
🍿️ DualSubs.TV+.Translate.Subtitles.response = type=http-response, pattern=^https?:\/\/vod-(.+)-(aoc|svod)\.tv\.apple\.com\/itunes-assets\/(.+)\/([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12})\/(.+)\.webvtt\?(.*)subtype=Translate, requires-body=1, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/main/modules/streaming/appletv/scripts/DualSubs.Translate.js, argument=Types="{{{Types}}}"&Languages[0]="{{{Languages[0]}}}"&Languages[1]="{{{Languages[1]}}}"&Position="{{{Position}}}"&Vendor="{{{Vendor}}}"&ShowOnly="{{{ShowOnly}}}"&LogLevel="{{{LogLevel}}}"

[MITM]
hostname = %APPEND% uts-api.itunes.apple.com, umc-tempo-api.apple.com, play-cdn.itunes.apple.com, play-edge-cdn.itunes.apple.com, hls.itunes.apple.com, hls-svod.itunes.apple.com, vod-*.tv.apple.com

#!name=YouTube Premium-like Universal
#!desc=YouTube + YouTube Music，覆盖 Mac 网页与 iPhone/iPad App：清理广告并保持登录、菜单与播放链路原生完整。所有运行脚本均托管在本仓库。
#!arguments=hideShorts:false,debug:false
#!arguments-desc=hideShorts：是否隐藏 Shorts；debug：是否输出调试日志。

[Rule]
DOMAIN-SUFFIX,doubleclick.net,REJECT-TINYGIF,pre-matching,extended-matching
DOMAIN-SUFFIX,googlesyndication.com,REJECT-TINYGIF,pre-matching,extended-matching
DOMAIN-SUFFIX,googleadservices.com,REJECT-TINYGIF,pre-matching,extended-matching
DOMAIN-SUFFIX,2mdn.net,REJECT-TINYGIF,pre-matching,extended-matching
DOMAIN-SUFFIX,googletagservices.com,REJECT-TINYGIF,pre-matching,extended-matching
DOMAIN,youtube-ads.l.google.com,REJECT-TINYGIF,pre-matching,extended-matching

[URL Rewrite]
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302
^https?:\/\/(www\.|m\.)?youtube\.com\/youtubei\/v1\/player\/ad_break _ reject
^https?:\/\/(www\.|m\.|s\.)?youtube\.com\/api\/stats\/ads _ reject
^https?:\/\/(www\.|m\.)?youtube\.com\/pcs\/activeview _ reject
^https?:\/\/(www\.|m\.)?youtube\.com\/pagead\/ _ reject
^https?:\/\/(www\.|m\.)?youtube\.com\/ptracking _ reject
^https?:\/\/(www\.|m\.)?youtube\.com\/get_midroll_ _ reject
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext _ reject

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback(?:\?|\/))).+&oad data-type=text data=" " status-code=200

[Script]
youtube.web.compat = type=http-request,pattern=^https:\/\/(www\.|m\.)?youtube\.com\/youtubei\/v1\/.*,script-path=https://raw.githubusercontent.com/nrhb11/surge-youtube-premium-like/main/youtube-web-request.js?v=20260823.1,script-update-interval=3600
youtube.music.compat = type=http-request,pattern=^https:\/\/music\.youtube\.com\/.*,script-path=https://raw.githubusercontent.com/nrhb11/surge-youtube-premium-like/main/youtube-music-request.js?v=20260823.1,script-update-interval=3600
youtube.web.api = type=http-response,pattern=^https:\/\/(www\.|m\.)?youtube\.com\/youtubei\/v1\/(browse|next|search|player|get_watch)(\?.*)?$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/nrhb11/surge-youtube-premium-like/main/youtube-premium-like.js?v=20260823.8,argument="{\"hideShorts\":{{{hideShorts}}},\"debug\":{{{debug}}}}",script-update-interval=3600
youtube.music.api = type=http-response,pattern=^https:\/\/music\.youtube\.com\/youtubei\/v1\/(browse|next|search|player|queue|get_watch)(\?.*)?$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/nrhb11/surge-youtube-premium-like/main/youtube-premium-like.js?v=20260823.8,argument="{\"hideShorts\":{{{hideShorts}}},\"debug\":{{{debug}}}}",script-update-interval=3600
youtube.mobile.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|config|log_event)(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/nrhb11/surge-youtube-premium-like/main/vendor/youtube-mobile-response.js?v=20260823.2,argument="{\"captionLang\":\"off\",\"blockUpload\":false,\"blockImmersive\":false,\"blockShorts\":{{{hideShorts}}},\"debug\":{{{debug}}}}",script-update-interval=3600

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, www.youtube.com, youtube.com, m.youtube.com, music.youtube.com, s.youtube.com, youtubei.googleapis.com

#!name=YouTube Premium-like
#!desc=Surge Mac 网页版：去广告、隐藏 Premium 推销、Premium 风格标识、画中画按钮。不会解锁服务器端会员权益。
#!system=mac
#!arguments=hideShorts:false,debug:false
#!arguments-desc=hideShorts：是否隐藏 Shorts；debug：是否输出调试日志。

[Rule]
DOMAIN-SUFFIX,doubleclick.net,REJECT-TINYGIF,pre-matching,extended-matching
DOMAIN-SUFFIX,googlesyndication.com,REJECT-TINYGIF,pre-matching,extended-matching
DOMAIN-SUFFIX,googleadservices.com,REJECT-TINYGIF,pre-matching,extended-matching
DOMAIN-SUFFIX,2mdn.net,REJECT-TINYGIF,pre-matching,extended-matching
DOMAIN-SUFFIX,googletagservices.com,REJECT-TINYGIF,pre-matching,extended-matching
DOMAIN,youtube-ads.l.google.com,REJECT-TINYGIF,pre-matching,extended-matching

[URL Rewrite]
^https?:\/\/(www\.|m\.)?youtube\.com\/youtubei\/v1\/player\/ad_break _ reject
^https?:\/\/(www\.|m\.)?youtube\.com\/api\/stats\/ads _ reject
^https?:\/\/(www\.|m\.)?youtube\.com\/pcs\/activeview _ reject
^https?:\/\/(www\.|m\.)?youtube\.com\/pagead\/ _ reject
^https?:\/\/(www\.|m\.)?youtube\.com\/ptracking _ reject
^https?:\/\/(www\.|m\.)?youtube\.com\/get_midroll_ _ reject

[Script]
youtube.premium.api = type=http-response,pattern=^https:\/\/(www\.|m\.)?youtube\.com\/youtubei\/v1\/(browse|next|search|player|guide|get_watch)(\?.*)?$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/nrhb11/surge-youtube-premium-like/main/youtube-premium-like.js,argument="{\"hideShorts\":{{{hideShorts}}},\"debug\":{{{debug}}}}"
youtube.premium.googleapis = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|search|player|guide|get_watch)(\?.*)?$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/nrhb11/surge-youtube-premium-like/main/youtube-premium-like.js,argument="{\"hideShorts\":{{{hideShorts}}},\"debug\":{{{debug}}}}"
youtube.premium.home = type=http-response,pattern=^https:\/\/(www\.|m\.)?youtube\.com\/(\?.*)?$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/nrhb11/surge-youtube-premium-like/main/youtube-premium-like.js,argument="{\"hideShorts\":{{{hideShorts}}},\"debug\":{{{debug}}}}"
youtube.premium.watch = type=http-response,pattern=^https:\/\/(www\.|m\.)?youtube\.com\/watch\?.*$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/nrhb11/surge-youtube-premium-like/main/youtube-premium-like.js,argument="{\"hideShorts\":{{{hideShorts}}},\"debug\":{{{debug}}}}"
youtube.premium.results = type=http-response,pattern=^https:\/\/(www\.|m\.)?youtube\.com\/results\?.*$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/nrhb11/surge-youtube-premium-like/main/youtube-premium-like.js,argument="{\"hideShorts\":{{{hideShorts}}},\"debug\":{{{debug}}}}"
youtube.premium.shorts = type=http-response,pattern=^https:\/\/(www\.|m\.)?youtube\.com\/shorts\/.*$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/nrhb11/surge-youtube-premium-like/main/youtube-premium-like.js,argument="{\"hideShorts\":{{{hideShorts}}},\"debug\":{{{debug}}}}"

[MITM]
hostname = %APPEND% www.youtube.com, youtube.com, m.youtube.com, youtubei.googleapis.com
